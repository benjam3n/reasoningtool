  alphacode_pass3_meta: 'apm',
  analogy_search: 'ans',
  analysis: 'analyze',
  anticipated_failures_analysis: 'afa',
  araw_gosm_integration: 'agi',
  architecture_design: 'arcd',
  assumeright_assumewrong_search: 'araw',
  bandit_exploration: 'be',
  business_operations: 'bo',
  client_retention: 'clr',
  cognitive_amplification: 'cga',
  collective_goals: 'clg',
  communication_narrative: 'cn',
  comparison: 'cmp',
  comprehensive_aspects: 'cpra',
  constraint_solving: 'cns',
  constraint_workarounds: 'cnw',
  crisis_triage: 'ct',
  criteria_weighting: 'crw',
  critique: 'cri',
  cross_domain_bridge: 'cdb',
  cross_project_pattern_detection: 'cppd',
  decision_trees: 'dct',
  deductive_adversarial_review_integration: 'dari',
  deductive_strategy_discovery: 'dsd',
  deductive_strategy_evaluation: 'dse',
  delayed_outcome_tracking: 'dot',
  design: 'dsn',
  design_procedures: 'dsn',
  design_system: 'dss',
  design_thinking_lean: 'dtl',
  detection_verification: 'dv',
  diversity_search: 'dvs',
  epistemic_hierarchy: 'eh',
  evaluation_dimensions: 'evd',
  evolutionary_strategies: 'es',
  expected_value: 'exv',
  failure_attribution: 'fat',
  failure_journeys: 'fj',
  fairness_allocation: 'faa',
  feedback: 'fb',
  finder: 'fnd',
  gate_as_claim_audit: 'gaca',
  gate_execution_engine: 'gee',
  generate: 'gen',
  generate_then_search: 'gts',
  goal_decomposition: 'gd',
  goal_reframing: 'grfr',
  goal_understanding: 'gu',
  graph_traversal: 'gt',
  guess_generation: 'gg',
  health_optimization: 'ho',
  innovation_engine: 'ie',
  inversion_method: 'im',
  iterative_discovery_goals: 'idg',
  journey_extraction: 'je',
  learning_discovery: 'ld',
  leverage_point_discovery: 'lpd',
  leverage_points: 'lp',
  local_search: 'lcs',
  logical_proof_system: 'lps',
  marketing_funnel: 'mf',
  military_strategy: 'mil',
  morphological_analysis: 'ma',
  motivation_psychology: 'mp',
  multi_criteria_decision: 'mcd',
  multi_party_goals: 'mpg',
  music_composition_performance: 'mcp',
  negotiation_strategy: 'ns',
  networking: 'net',
  ooda_loop: 'ol',
  ordering_variations: 'ov',
  pairwise_comparison: 'pwc',
  paradox_goals: 'pag',
  pedagogy_educational: 'pge',
  population_based_search: 'pbs',
  positioning: 'pos',
