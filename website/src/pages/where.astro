---
import { ViewTransitions } from 'astro:transitions';
import Paginated from '../components/Paginated.astro';
import whatsNew from '../data/whats-new.json';
import skillsCatalog from '../../../claude-code-plugin/skills.json';
import {
  DICTIONARY_SOURCE,
  EMOJI_SOURCE,
  NAV_EMOJI_CATEGORIES,
  NAV_LETTERS,
  NAV_WORDS_BY_LETTER,
} from '../data/navigation-vocabulary';
import '../styles/global.css';

const rawEntries = Array.isArray(whatsNew) ? whatsNew : [];
const skillMeta = skillsCatalog.skills || {};

const slugify = (value: string) =>
  String(value || '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '_')
    .replace(/^_+|_+$/g, '');

const LEGACY_SKILL_ALIASES: Record<string, string> = {
  adversarial_review: 'advr',
  after_action_review: 'aar',
  algorithmic_optimization: 'ao',
  alphacode_pass1_explicit: 'ape',
