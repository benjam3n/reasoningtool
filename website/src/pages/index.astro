tier1.forEach(s => tierMap.set(s.name, { name: s.name, title: s.title, tier: '1', desc: s.desc }));
tier2.forEach(s => tierMap.set(s.name, { name: s.name, title: s.title, tier: '2', desc: s.desc }));
categorySkills.forEach(s => { if (!tierMap.has(s.name)) tierMap.set(s.name, { name: s.name, title: s.title, tier: 'cat', desc: s.desc }); });
tier3Categories.forEach(c => c.skills.forEach(s => { if (!tierMap.has(s.name)) tierMap.set(s.name, { name: s.name, title: s.title, tier: '3', category: c.category }); }));
tier4Categories.forEach(c => c.skills.forEach(s => { if (!tierMap.has(s.name)) tierMap.set(s.name, { name: s.name, title: s.title, tier: '4', category: c.category }); }));

const manifestSkills = (skillsManifest as any).skills || {};
for (const [id, meta] of Object.entries<any>(manifestSkills)) {
  if (tierMap.has(id)) {
    const existing = tierMap.get(id)!;
    existing.desc = existing.desc || meta.description || '';
    existing.category = existing.category || meta.category || '';
    existing.useful = (meta.invoked_by?.length || 0) + (meta.invokes?.length || 0) * 0.25;
    existing.tags = existing.tags || meta.tags || [];
    continue;
  }
  let tier = '3';
  if (meta.tier === 'category') tier = 'cat';
  else if (typeof meta.tier === 'string' && meta.tier.startsWith('tier')) tier = meta.tier.replace('tier', '');
  tierMap.set(id, {
    name: id,
    title: meta.title || id,
    tier,
    desc: meta.description || '',
    category: meta.category || '',
    useful: (meta.invoked_by?.length || 0) + (meta.invokes?.length || 0) * 0.25,
    tags: meta.tags || [],
  });
}

const allSkills = Array.from(tierMap.values()).sort((a, b) => a.name.localeCompare(b.name));
const totalCount = allSkills.length;

const allCategories = [
  ...tier3Categories.map(c => c.category),
  ...tier4Categories.map(c => c.category),
].filter((v, i, a) => a.indexOf(v) === i).sort();

// Compute all tags by frequency
const tagCounts = new Map<string, number>();
allSkills.forEach(s => (s.tags || []).forEach(t => {
  if (t !== 'shortcut' && t !== 'pick') tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
}));
const allTagsSorted = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([tag]) => tag);

// Two-level tag hierarchy: meta-categories → individual tags
const tagMetaCategories: Record<string, string[]> = {
  'Analysis': ['analysis', 'decomposition', 'comparison', 'extraction', 'causal', 'diagnosis', 'root', 'root-cause', 'cause', 'inference', 'derivation', 'interpretation', 'evaluation', 'assessment', 'statistical', 'qualitative', 'dimensions', 'specificity', 'identification', 'parsing', 'field'],
  'Search & Discovery': ['discovery', 'search', 'space', 'space-mapping', 'method', 'sweep', 'elimination', 'matching', 'finder', 'lookup', 'navigation', 'exploration', 'guess', 'guesses', 'novelty', 'non-obvious', 'unexpected'],
  'Decision & Strategy': ['decision', 'making', 'strategy', 'strategies', 'plan', 'planning', 'plans', 'prioritization', 'option', 'alternatives', 'selection', 'preference', 'criteria', 'weighting', 'pairwise', 'tradeoff', 'roi', 'cost', 'benefit', 'risk', 'reversibility'],
  'Goals & Wants': ['goal', 'desire', 'journey', 'commitments', 'path', 'progress', 'closure', 'clarity', 'understanding'],
  'Validation & Audit': ['audit', 'check', 'verification', 'verify', 'validation', 'validity', 'testing', 'evidence', 'evidence-based', 'credibility', 'consistency', 'self-audit'],
  'Failure & Recovery': ['failure', 'recovery', 'diagnosis', 'debugging', 'prevention', 'anticipation', 'mortem', 'pre', 'retrospective', 'rejection', 'plateaus'],
  'Creative & Generation': ['creative', 'generation', 'divergent', 'divergence', 'morphological', 'scamper', 'analogy', 'cross-domain', 'metaphor', 'storytelling', 'reframe', 'reframing', 'variation'],
  'Writing & Communication': ['writing', 'communication', 'persuasive', 'speaking', 'presentation', 'content', 'language', 'listening', 'outreach', 'advocacy', 'media', 'email', 'typography', 'layout'],
  'Research & Data': ['research', 'source', 'data', 'collection', 'gathering', 'literature', 'academic', 'reading', 'experiments', 'experimental', 'evidence', 'report', 'survey'],
  'Self & Meta': ['self', 'meta', 'reasoning', 'mental', 'model', 'models', 'assumptions', 'assumption', 'inversion', 'steelman', 'adversarial', 'critique', 'feedback', 'calibration', 'habit', 'learning', 'mastery', 'practice', 'deliberate'],
  'Procedures & Systems': ['procedure', 'system', 'systems', 'systematic', 'protocol', 'flowchart', 'pipeline', 'automation', 'automated', 'integration', 'infrastructure', 'architecture', 'schema', 'structure'],
  'Business & Finance': ['financial', 'fundraising', 'budget', 'budgeting', 'investment', 'income', 'cash', 'grant', 'salary', 'market', 'marketing', 'competitive', 'growth', 'viral', 'seo', 'freelancing', 'client', 'positioning', 'customer', 'funnel', 'targeting'],
  'Frameworks & Patterns': ['framework', 'araw', 'gosm', 'uaua', 'gate', 'compound', 'chain', 'recursive', 'universal', 'bounded', 'probabilistic', 'binary', 'conditional', 'mechanical', 'trees', 'taxonomy'],
  'Skills & Tools': ['skill', 'routing', 'registry', 'refactoring', 'improvement', 'capability', 'benchmarking', 'api', 'mcp', 'code', 'deployment', 'security'],
  'People & Collaboration': ['negotiation', 'conflict', 'stakeholder', 'delegation', 'group', 'social', 'interview', 'networking', 'human', 'personal', 'career', 'job', 'resume', 'team'],
  'Design & Output': ['design', 'review', 'artifacts', 'output', 'requirements', 'delivery', 'project', 'management', 'tracking', 'setup', 'preparation', 'recommendations', 'actionable', 'steps'],
};

// For each meta-category, only keep tags that actually exist in the data
const tagHierarchy: { meta: string; tags: string[] }[] = [];
for (const [meta, candidateTags] of Object.entries(tagMetaCategories)) {
  const existing = candidateTags.filter(t => tagCounts.has(t)).sort((a, b) => (tagCounts.get(b) || 0) - (tagCounts.get(a) || 0));
  if (existing.length > 0) tagHierarchy.push({ meta, tags: existing });
}

// Collect uncategorized tags (exist in data but not in any meta-category)
const categorizedTags = new Set(Object.values(tagMetaCategories).flat());
const uncategorized = allTagsSorted.filter(t => !categorizedTags.has(t) && t !== 'shortcut' && t !== 'pick');
if (uncategorized.length > 0) tagHierarchy.push({ meta: 'Other', tags: uncategorized });

// Build meta→tags map for JS
const TAG_META_MAP: Record<string, string[]> = {};
tagHierarchy.forEach(g => { TAG_META_MAP[g.meta] = g.tags; });
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={`${totalCount} structured reasoning skills for Claude Code.`} />
  <title>reasoningtool</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <ViewTransitions />
</head>
<body class="skills-page">
  <section class="skill-cloud">
    <div class="site-header">
      <a href="/" class="site-logo-link">
        <img src="/logo.png" alt="Reasoning Tool" class="site-logo" />
        <div class="site-logo-text">
          <span class="site-title">REASONING TOOL</span>
          <span class="site-subtitle">reasoningtool.com</span>
        </div>
      </a>
      <div class="site-header-right">
        <input type="text" id="skill-search" class="skill-search" placeholder="Search skills..." autocomplete="off" />
        <button class="nav-chip" id="theme-toggle" aria-label="Toggle dark mode"><span id="theme-icon">&#9790;</span></button>
      </div>
    </div>
    <div class="sort-controls" id="sort-controls">
      <button class="sort-chip active" data-sort="alphabetical">Alphabetical</button>
      <button class="sort-chip" data-sort="cool">Cool</button>
      <button class="sort-chip" data-sort="technical">Technical</button>
      <button class="sort-chip" data-sort="generality">Generality</button>
      <button class="sort-chip" data-sort="specificity">Specificity</button>
      <button class="sort-chip" data-sort="uniqueness">Uniqueness</button>
      <button class="sort-chip" data-sort="random">Random</button>
      <button class="sort-chip" data-sort="categorized">Categorized</button>
      <button class="sort-chip" data-sort="usefulness">Usefulness</button>
      <button class="sort-chip" data-sort="uselessness">Uselessness</button>
    </div>
    <div class="filter-controls" id="filter-controls">
      <span class="filter-label">Tier</span>
      <button class="sort-chip filter-chip filter-chip--tier active" data-filter-tier="all">All</button>
      <button class="sort-chip filter-chip filter-chip--tier filter-chip--1" data-filter-tier="1">Core</button>
      <button class="sort-chip filter-chip filter-chip--tier filter-chip--2" data-filter-tier="2">Important</button>
      <button class="sort-chip filter-chip filter-chip--tier filter-chip--cat" data-filter-tier="cat">Category</button>
      <button class="sort-chip filter-chip filter-chip--tier filter-chip--3" data-filter-tier="3">Domain</button>
      <button class="sort-chip filter-chip filter-chip--tier filter-chip--4" data-filter-tier="4">Specialized</button>
      <button class="sort-chip filter-chip filter-chip--tier filter-chip--exp" data-filter-tier="exp">Experimental</button>
      <span class="filter-sep"></span>
      <button class="sort-chip filter-chip mobile-cat-toggle" id="mobile-cat-toggle">Categories ▸</button>
      <button class="sort-chip filter-chip mobile-tag-toggle" id="mobile-tag-toggle">Tags ▸</button>
      <span class="filter-label filter-label--cat">Category</span>
      {allCategories.map(cat => (
        <button class="sort-chip filter-chip filter-chip--cat-btn" data-filter-category={cat.toLowerCase()}>{cat}</button>
      ))}
      <div class="tag-meta-row" id="tag-meta-row">
        <span class="filter-label filter-label--tag">Tags</span>
        {tagHierarchy.map(g => (
          <button class="sort-chip filter-chip filter-chip--tag-meta" data-tag-meta={g.meta}>{g.meta}</button>
        ))}
      </div>
      <div class="tag-children-row" id="tag-children-row">
        {tagHierarchy.map(g => (
          g.tags.map(tag => (
            <button class="sort-chip filter-chip filter-chip--tag-btn" data-filter-tag={tag} data-tag-parent={g.meta} style="display:none;">{tag} <span class="tag-count">{tagCounts.get(tag)}</span></button>
          ))
        ))}
      </div>
    </div>
    {allSkills.map(s => (
      <a
        href={`/skills/${s.name}`}
        class={`skill-chip skill-chip--${s.tier}`}
        data-title={s.title.toLowerCase()}
        data-desc={(s.desc || '').toLowerCase()}
        data-category={(s.category || '').toLowerCase()}
        data-tags={(s.tags || []).join(',')}
        data-useful={String(s.useful || 0)}
      >{s.name}</a>
    ))}
  </section>
  <div class="mobile-footer-stack">
    <nav class="desktop-bottom-bar" aria-label="Site navigation">
      <a href="/" class="nav-chip">Skills</a>
      <button class="nav-chip pg-github" data-url="https://github.com/benjam3n/reasoningtool">GitHub</button>
      <a href="/visuals" class="nav-chip">Visuals</a>
      <a href="/faq" class="nav-chip">FAQ</a>
      <a href="/questions" class="nav-chip">Questions</a>
      <a href="/installation" class="nav-chip">Install</a>
      <a href="/where" class="nav-chip">Where</a>
      <a href="/about" class="nav-chip">About</a>
    </nav>
    <nav class="mobile-bottom-bar" aria-label="Mobile navigation">
      <a href="/" class="mobile-bottom-bar__btn">Skills</a>
      <button class="mobile-bottom-bar__btn pg-github" data-url="https://github.com/benjam3n/reasoningtool">GitHub</button>
      <a href="/visuals" class="mobile-bottom-bar__btn">Visuals</a>
      <a href="/faq" class="mobile-bottom-bar__btn">FAQ</a>
      <a href="/questions" class="mobile-bottom-bar__btn">Questions</a>
      <a href="/installation" class="mobile-bottom-bar__btn">Install</a>
      <a href="/about" class="mobile-bottom-bar__btn">About</a>
    </nav>
    <div class="mobile-skill-pager" id="mobile-skill-pager" aria-label="Skill pages"></div>
  </div>

  <script define:vars={{ NAV_LETTERS, NAV_WORDS_BY_LETTER, NAV_EMOJI_CATEGORIES, TAG_META_MAP }}>
    (function() {
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

      function applyTheme() {
        var stored = localStorage.getItem('theme');
        if (stored) document.documentElement.setAttribute('data-theme', stored);
      }

      function updateIcon() {
        var isDark = document.documentElement.getAttribute('data-theme') === 'dark' ||
          (!document.documentElement.getAttribute('data-theme') && prefersDark);
        var icon = document.getElementById('theme-icon');
        if (icon) icon.textContent = isDark ? '\u2600' : '\u263E';
      }

      var _lastCloud = null;
      function setup() {
        var cloudEl = document.querySelector('.skill-cloud');
        if (!cloudEl) return; // Not on the skills page
        if (cloudEl === _lastCloud) return; // Same DOM, already set up
        _lastCloud = cloudEl;

        applyTheme();
        updateIcon();

        var btn = document.getElementById('theme-toggle');
        if (btn) {
          btn.addEventListener('click', function() {
            var current = document.documentElement.getAttribute('data-theme');
            var isDark = current === 'dark' || (!current && prefersDark);
            var next = isDark ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
            updateIcon();
          });
        }

        // GitHub toggle buttons
        document.querySelectorAll('.pg-github').forEach(function(btn) {
          var el = btn;
          var url = el.dataset.url || 'https://github.com/benjam3n/reasoningtool';
          var originalText = el.textContent || 'GitHub';
          var armed = false;

          el.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (armed) {
              window.open(url, '_blank', 'noopener');
              el.textContent = originalText;
              armed = false;
            } else {
              el.textContent = 'Go to GitHub';
              armed = true;
            }
          });

          document.addEventListener('click', function() {
            if (armed) {
              el.textContent = originalText;
              armed = false;
            }
          });
        });

        // Skill search filtering
        var searchInput = document.getElementById('skill-search');
        var cloud = document.querySelector('.skill-cloud');
        var mobilePager = document.getElementById('mobile-skill-pager');
        var chips = Array.from(document.querySelectorAll('.skill-chip'));
        var currentMobilePage = 0;
        var mobilePageCount = 1;

        function updateFooterOffset() {
          var footer = document.querySelector('.mobile-footer-stack');
          if (!footer || !isMobile()) {
            document.documentElement.style.removeProperty('--mobile-footer-offset');
            return 0;
          }
          var footerHeight = Math.ceil(footer.getBoundingClientRect().height);
          document.documentElement.style.setProperty('--mobile-footer-offset', footerHeight + 'px');
          return footerHeight;
        }

        chips.forEach(function(chip) {
          chip.dataset.searchHidden = '0';
          chip.dataset.filterHidden = '0';
        });

        var currentTierFilter = 'all';
        var currentCategoryFilter = '';
        var currentTagFilter = '';
        var currentTagMeta = '';
        var currentSort = 'alphabetical';

        function saveState() {
          try {
            sessionStorage.setItem('rt_state', JSON.stringify({
              tier: currentTierFilter,
              cat: currentCategoryFilter,
              tagMeta: currentTagMeta || '',
              tag: currentTagFilter,
              sort: currentSort,
              q: searchInput ? searchInput.value : ''
            }));
          } catch(e) {}
        }

        function applyFilters() {
          var q = searchInput ? searchInput.value.toLowerCase().trim() : '';
          chips.forEach(function(chip) {
            var name = chip.textContent.toLowerCase();
            var title = chip.getAttribute('data-title') || '';
            var searchMatch = !q || name.indexOf(q) !== -1 || title.indexOf(q) !== -1;

            var tierMatch = true;
            if (currentTierFilter !== 'all') {
              tierMatch = chip.classList.contains('skill-chip--' + currentTierFilter);
            }

            var catMatch = true;
            if (currentCategoryFilter) {
              var chipCat = (chip.getAttribute('data-category') || '').toLowerCase();
              catMatch = chipCat === currentCategoryFilter;
            }

            var tagMatch = true;
            if (currentTagFilter) {
              var chipTags = (chip.getAttribute('data-tags') || '').split(',');
              tagMatch = chipTags.indexOf(currentTagFilter) !== -1;
            } else if (currentTagMeta && TAG_META_MAP[currentTagMeta]) {
              var chipTags2 = (chip.getAttribute('data-tags') || '').split(',');
              var metaTags = TAG_META_MAP[currentTagMeta];
              tagMatch = false;
              for (var ti = 0; ti < metaTags.length; ti++) {
                if (chipTags2.indexOf(metaTags[ti]) !== -1) { tagMatch = true; break; }
              }
            }

            chip.dataset.searchHidden = (searchMatch && tierMatch && catMatch && tagMatch) ? '0' : '1';
          });
          currentMobilePage = 0;
          applyMobilePagination();
          saveState();
        }

        // Tier filter buttons
        document.querySelectorAll('[data-filter-tier]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var tier = btn.getAttribute('data-filter-tier');
            if (tier === currentTierFilter && tier !== 'all') {
              // Deactivate: reset to all
              currentTierFilter = 'all';
            } else {
              currentTierFilter = tier;
            }
            document.querySelectorAll('[data-filter-tier]').forEach(function(b) { b.classList.remove('active'); });
            if (currentTierFilter === 'all') {
              document.querySelector('[data-filter-tier="all"]').classList.add('active');
            } else {
              btn.classList.add('active');
            }
            applyFilters();
          });
        });

        // Category filter buttons
        document.querySelectorAll('[data-filter-category]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var cat = btn.getAttribute('data-filter-category');
            if (cat === currentCategoryFilter) {
              // Deactivate
              currentCategoryFilter = '';
              btn.classList.remove('active');
            } else {
              document.querySelectorAll('[data-filter-category]').forEach(function(b) { b.classList.remove('active'); });
              currentCategoryFilter = cat;
              btn.classList.add('active');
            }
            applyFilters();
          });
        });

        // Tag meta-category buttons (two-level: click meta → show children)
        document.querySelectorAll('[data-tag-meta]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var meta = btn.getAttribute('data-tag-meta');
            // Toggle: click same meta again to collapse
            var childrenRow = document.getElementById('tag-children-row');
            if (meta === currentTagMeta) {
              currentTagMeta = '';
              btn.classList.remove('active');
              // Hide all child tags
              document.querySelectorAll('[data-filter-tag]').forEach(function(t) { t.style.display = 'none'; });
              if (childrenRow) childrenRow.classList.remove('visible');
              // Clear any active tag filter
              currentTagFilter = '';
              applyFilters();
              return;
            }
            // Activate this meta
            document.querySelectorAll('[data-tag-meta]').forEach(function(b) { b.classList.remove('active'); });
            currentTagMeta = meta;
            btn.classList.add('active');
            // Show only children of this meta, hide others
            document.querySelectorAll('[data-filter-tag]').forEach(function(t) {
              t.style.display = t.getAttribute('data-tag-parent') === meta ? '' : 'none';
              t.classList.remove('active');
            });
            if (childrenRow) childrenRow.classList.add('visible');
            // Clear active tag
            currentTagFilter = '';
            applyFilters();
          });
        });

        // Tag child buttons (actual filter)
        document.querySelectorAll('[data-filter-tag]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var tag = btn.getAttribute('data-filter-tag');
            if (tag === currentTagFilter) {
              currentTagFilter = '';
              btn.classList.remove('active');
            } else {
              document.querySelectorAll('[data-filter-tag]').forEach(function(b) { b.classList.remove('active'); });
              currentTagFilter = tag;
              btn.classList.add('active');
            }
            applyFilters();
          });
        });

        // Mobile category toggle
        var catToggle = document.getElementById('mobile-cat-toggle');
        var filterControls = document.querySelector('.filter-controls');
        var tagToggle = document.getElementById('mobile-tag-toggle');
        if (catToggle && filterControls) {
          catToggle.addEventListener('click', function() {
            var isVisible = filterControls.classList.toggle('categories-visible');
            catToggle.textContent = isVisible ? 'Categories \u25BE' : 'Categories \u25B8';
            if (isVisible) {
              filterControls.classList.remove('tags-visible');
              if (tagToggle) tagToggle.textContent = 'Tags \u25B8';
            }
          });
        }

        // Mobile tag toggle
        if (tagToggle && filterControls) {
          tagToggle.addEventListener('click', function() {
            var isVisible = filterControls.classList.toggle('tags-visible');
            tagToggle.textContent = isVisible ? 'Tags \u25BE' : 'Tags \u25B8';
            if (isVisible) {
              filterControls.classList.remove('categories-visible');
              if (catToggle) catToggle.textContent = 'Categories \u25B8';
            }
          });
        }

        function isMobile() {
          return window.innerWidth <= 900;
        }

        function renderMobilePager() {
          if (!mobilePager) return;
          if (mobilePageCount <= 1) {
            mobilePager.innerHTML = '';
            mobilePager.style.display = 'none';
            updateFooterOffset();
            return;
          }

          mobilePager.style.display = isMobile() ? 'grid' : 'flex';
          mobilePager.style.setProperty('--pager-cols', String(mobilePageCount));
          mobilePager.innerHTML = '';

          function getNavLabel(pageNumber) {
            var letterIndex = (pageNumber - 1) % NAV_LETTERS.length;
            var letterLap = Math.floor((pageNumber - 1) / NAV_LETTERS.length);
            var letter = NAV_LETTERS[letterIndex];
            var words = NAV_WORDS_BY_LETTER[letter] || [letter.toLowerCase()];
            var word = words[letterLap % words.length];

            var categoryIndex = (pageNumber - 1) % NAV_EMOJI_CATEGORIES.length;
            var categoryLap = Math.floor((pageNumber - 1) / NAV_EMOJI_CATEGORIES.length);
            var category = NAV_EMOJI_CATEGORIES[categoryIndex];
            var emoji = category.emojis[categoryLap % category.emojis.length];

            return { word: word, emoji: emoji, title: letter + ' | ' + category.label };
          }

          var onDesktop = !isMobile();
          // Get the Astro scoped CSS attribute from an existing element
          var scopeAttr = '';
          var existingChip = document.querySelector('.nav-chip');
          if (existingChip) {
            var attrs = existingChip.attributes;
            for (var ai = 0; ai < attrs.length; ai++) {
              if (attrs[ai].name.indexOf('data-astro-cid') === 0) {
                scopeAttr = attrs[ai].name;
                break;
              }
            }
          }

          for (var i = 0; i < mobilePageCount; i++) {
            var label = getNavLabel(i + 1);
            var btn = document.createElement('button');

            if (onDesktop) {
              // Desktop: use nav-chip class for identical styling to nav bar
              btn.className = 'nav-chip pager-btn' + (i === currentMobilePage ? ' pager-btn--active' : '');
              if (scopeAttr) btn.setAttribute(scopeAttr, '');
              btn.textContent = 'Page ' + (i + 1);
            } else {
              // Mobile: rich button with idx + word + emoji
              btn.className = 'mobile-bottom-bar__btn mobile-skill-pager__btn' + (i === currentMobilePage ? ' mobile-skill-pager__btn--active' : '');

              var idx = document.createElement('span');
              idx.className = 'mobile-skill-pager__idx';
              idx.textContent = String(i + 1);

              var word = document.createElement('span');
              word.className = 'mobile-skill-pager__word';
              word.textContent = label.word;

              var emo = document.createElement('span');
              emo.className = 'mobile-skill-pager__emo';
              emo.textContent = label.emoji;

              btn.appendChild(idx);
              btn.appendChild(word);
              btn.appendChild(emo);
            }

            btn.title = label.title;
            (function(pageIndex) {
              btn.addEventListener('click', function() {
                currentMobilePage = pageIndex;
                applyMobilePagination();
              });
            })(i);
            mobilePager.appendChild(btn);
          }

          var activeBtn = mobilePager.querySelector('.mobile-skill-pager__btn--active, .pager-btn--active');
          if (activeBtn) {
            activeBtn.scrollIntoView({ inline: 'nearest', block: 'nearest' });
          }

          updateFooterOffset();
        }

        function getTargetMobilePageCount(visibleCount) {
          // Aim for ~80-100 skills per page, max 6 pages
          // Don't create pages with fewer than ~30 skills
          if (!visibleCount || visibleCount <= 100) return 1;
          if (visibleCount <= 200) return 2;
          if (visibleCount <= 300) return 3;
          if (visibleCount <= 400) return 4;
          if (visibleCount <= 500) return 5;
          return 6;
        }

        function applyMobilePagination() {
          if (!cloud) return;

          var visible = chips.filter(function(chip) {
            return chip.dataset.searchHidden !== '1';
          });

          chips.forEach(function(chip) {
            chip.style.display = chip.dataset.searchHidden === '1' ? 'none' : '';
          });

          // Pagination applies on both mobile and desktop

          if (visible.length === 0) {
            mobilePageCount = 1;
            currentMobilePage = 0;
            renderMobilePager();
            return;
          }

          mobilePageCount = Math.max(1, Math.min(getTargetMobilePageCount(visible.length), visible.length));
          currentMobilePage = Math.min(currentMobilePage, mobilePageCount - 1);
          var skillsPerPage = Math.ceil(visible.length / mobilePageCount);
          var start = currentMobilePage * skillsPerPage;
          var end = start + skillsPerPage;

          visible.forEach(function(chip) {
            chip.style.display = 'none';
          });

          visible.slice(start, end).forEach(function(chip) {
            chip.style.display = '';
          });

          renderMobilePager();
        }

        if (searchInput) {
          searchInput.addEventListener('input', function() {
            applyFilters();
          });
        }

        function score(chip, mode) {
          var name = (chip.textContent || '').toLowerCase();
          var title = (chip.getAttribute('data-title') || '').toLowerCase();
          var desc = (chip.getAttribute('data-desc') || '').toLowerCase();
          var cat = (chip.getAttribute('data-category') || '').toLowerCase();
          var useful = parseFloat(chip.getAttribute('data-useful') || '0');
          var text = [name, title, desc, cat].join(' ');
          var tech = /(api|code|deploy|security|architecture|test|debug|software|engineering|database|embedded)/.test(text) ? 1 : 0;
          var broad = /(universal|any|general|router|meta|goal|analyze|evaluate|search)/.test(text) ? 1 : 0;
          var specific = /(proteomics|biomedical|grant|salary|interview|mechanical|embedded|policy|market)/.test(text) ? 1 : 0;
          var cool = /(unexpected|viral|innovation|creative|novelty|strategy|meta)/.test(text) ? 1 : 0;
          var uniq = (name.length > 7 ? 1 : 0) + (/[^a-z]/.test(name) ? 1 : 0) + (specific ? 1 : 0);

          if (mode === 'technical') return tech * 10 + useful;
          if (mode === 'generality') return broad * 10 - specific + useful * 0.1;
          if (mode === 'specificity') return specific * 10 + uniq;
          if (mode === 'uniqueness') return uniq * 10 + (specific ? 2 : 0);
          if (mode === 'cool') return cool * 10 + uniq + useful * 0.1;
          if (mode === 'usefulness') return useful;
          if (mode === 'uselessness') return -useful;
          return 0;
        }

        function sortChips(mode) {
          if (!cloud) return;
          var chips = Array.from(cloud.querySelectorAll('.skill-chip'));
          if (mode === 'random') {
            chips.sort(function() { return Math.random() - 0.5; });
          } else if (mode === 'alphabetical') {
            chips.sort(function(a, b) { return (a.textContent || '').localeCompare(b.textContent || ''); });
          } else if (mode === 'categorized') {
            chips.sort(function(a, b) {
              var ca = a.getAttribute('data-category') || '';
              var cb = b.getAttribute('data-category') || '';
              if (ca !== cb) return ca.localeCompare(cb);
              return (a.textContent || '').localeCompare(b.textContent || '');
            });
          } else {
            chips.sort(function(a, b) {
              return score(b, mode) - score(a, mode) || (a.textContent || '').localeCompare(b.textContent || '');
            });
          }
          chips.forEach(function(chip) { cloud.appendChild(chip); });
          applyMobilePagination();
        }

        document.querySelectorAll('.sort-chip').forEach(function(btn) {
          btn.addEventListener('click', function() {
            document.querySelectorAll('.sort-chip').forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
            var mode = btn.getAttribute('data-sort') || 'alphabetical';
            currentSort = mode;
            sortChips(mode);
            saveState();
          });
        });

        // Keep desktop cloud fixed. Allow normal scrolling on mobile.
        window.addEventListener('wheel', function(e) {
          if (window.innerWidth > 900) e.preventDefault();
        }, { passive: false });
        window.addEventListener('touchmove', function(e) {
          if (window.innerWidth > 900) e.preventDefault();
        }, { passive: false });
        window.addEventListener('resize', function() {
          updateFooterOffset();
          applyMobilePagination();
        });

        // Restore state from sessionStorage (survives back/forward navigation)
        try {
          var saved = JSON.parse(sessionStorage.getItem('rt_state') || '{}');
          if (saved.sort && saved.sort !== 'alphabetical') {
            currentSort = saved.sort;
            var sortBtn = document.querySelector('[data-sort="' + saved.sort + '"]');
            if (sortBtn) {
              document.querySelectorAll('[data-sort]').forEach(function(b) { b.classList.remove('active'); });
              sortBtn.classList.add('active');
              sortChips(saved.sort);
            }
          }
          if (saved.tier && saved.tier !== 'all') {
            currentTierFilter = saved.tier;
            document.querySelectorAll('[data-filter-tier]').forEach(function(b) { b.classList.remove('active'); });
            var tierBtn = document.querySelector('[data-filter-tier="' + saved.tier + '"]');
            if (tierBtn) tierBtn.classList.add('active');
          }
          if (saved.cat) {
            currentCategoryFilter = saved.cat;
            var catBtn = document.querySelector('[data-filter-category="' + saved.cat + '"]');
            if (catBtn) catBtn.classList.add('active');
            // Show categories on mobile
            var fc = document.querySelector('.filter-controls');
            if (fc) fc.classList.add('categories-visible');
            var ct = document.getElementById('mobile-cat-toggle');
            if (ct) ct.textContent = 'Categories \u25BE';
          }
          if (saved.tagMeta) {
            currentTagMeta = saved.tagMeta;
            var metaBtn = document.querySelector('[data-tag-meta="' + saved.tagMeta + '"]');
            if (metaBtn) {
              metaBtn.classList.add('active');
              // Show children of this meta
              document.querySelectorAll('[data-filter-tag]').forEach(function(t) {
                t.style.display = t.getAttribute('data-tag-parent') === saved.tagMeta ? '' : 'none';
              });
              var cr = document.getElementById('tag-children-row');
              if (cr) cr.classList.add('visible');
            }
            // Show tags on mobile
            var fc2 = document.querySelector('.filter-controls');
            if (fc2) fc2.classList.add('tags-visible');
            var tt = document.getElementById('mobile-tag-toggle');
            if (tt) tt.textContent = 'Tags \u25BE';
          }
          if (saved.tag) {
            currentTagFilter = saved.tag;
            var tagBtn = document.querySelector('[data-filter-tag="' + saved.tag + '"]');
            if (tagBtn) tagBtn.classList.add('active');
          }
          if (saved.q && searchInput) {
            searchInput.value = saved.q;
          }
          if (saved.tier || saved.cat || saved.tag || saved.q) {
            applyFilters();
          }
        } catch(e) {}

        updateFooterOffset();
        applyMobilePagination();
      }

      // astro:page-load fires on initial load + every View Transition (including back)
      document.addEventListener('astro:page-load', setup);
      // Fallback for non-Astro contexts
      document.addEventListener('DOMContentLoaded', setup);
      // bfcache restore: browser preserves same DOM, so clear ref to allow re-setup
      window.addEventListener('pageshow', function(e) {
        if (e.persisted) {
          _lastCloud = null;
          setup();
        }
      });
    })();
  </script>
</body>
</html>

